{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Week8 API (Ctrl+F5)",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "Week8.app.main:app",
                "--host",
                "0.0.0.0",
                "--port",
                "8000"
            ],
            "env": {
                "MYSQL_HOST": "127.0.0.1",
                "MYSQL_PORT": "3306",
                "MYSQL_USER": "library_user",
                "MYSQL_PASSWORD": "library_password",
                "MYSQL_DB": "library_db"
            },
            "console": "integratedTerminal"
        },
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        }
    ]
}
